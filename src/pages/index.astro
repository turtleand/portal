---
import Layout from '../layouts/Layout.astro';
import SharedLandscape from '../components/home/SharedLandscape.astro';
import { destinations } from '../data/destinations';
import { initI18n } from '../utils/i18n';
const { locale, dictionary, t } = initI18n(Astro);
const routingSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://turtleand.com/#website', name: 'Turtleand', url: 'https://turtleand.com/', description: t('home.description'), inLanguage: ['en', 'es'] },
    { '@type': 'WebPage', '@id': 'https://turtleand.com/#webpage', url: 'https://turtleand.com/', name: t('home.title'), description: t('home.description'), isPartOf: { '@id': 'https://turtleand.com/#website' }, mainEntity: { '@id': 'https://turtleand.com/#spaces' } },
    {
      '@type': 'ItemList', '@id': 'https://turtleand.com/#spaces', name: t('home.allSpaces'),
      itemListElement: destinations.map((space, index) => ({
        '@type': 'ListItem', position: index + 1,
        item: { '@type': 'WebSite', name: space.name, url: space.href, description: t(`home.destinations.${space.id}.description`) },
      })),
    },
  ],
};
---
<Layout locale={locale} dictionary={dictionary} variant="landscape" title={t('home.title')} description={t('home.description')} titleKey="home.title" descriptionKey="home.description">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(routingSchema).replace(/</g, '\\u003c')} />
  <SharedLandscape locale={locale} />
</Layout>
