---
import { avatarEvolutionStages } from '../../data/avatarEvolution';
import { createTranslator } from '../../utils/i18n';
import type { Locale } from '../../utils/i18n';

interface Props {
  locale: Locale;
}

const { locale = 'en' }: Partial<Props> = Astro.props;
const t = createTranslator(locale);
const firstStage = avatarEvolutionStages[0];
const firstTitle = locale === 'es' ? firstStage.titleEs : firstStage.title;
const firstDescription = locale === 'es' ? firstStage.descriptionEs : firstStage.description;
const progress = t('avatar.evolution.progress')
  .replace('{current}', '1')
  .replace('{total}', String(avatarEvolutionStages.length));
const timelineStyle = `grid-template-columns: repeat(${avatarEvolutionStages.length}, minmax(44px, 1fr)); min-width: max(100%, ${avatarEvolutionStages.length * 44 + (avatarEvolutionStages.length - 1) * 8}px);`;
const thumbnails = import.meta.glob<string>('../../images/avatar/3d-thumbnails/turtleand-*.webp', {
  eager: true,
  query: '?url&no-inline',
  import: 'default',
});
---

<section
  class="evolution-gallery relative isolate overflow-hidden rounded-3xl border border-white/10 bg-deepBlue/80 p-4 shadow-[0_20px_60px_rgba(4,10,25,0.55)] backdrop-blur sm:p-6"
  data-avatar-evolution
>
  <div class="evolution-content space-y-5">
    <header class="space-y-1 text-center">
      <p
        class="evolution-2d-only text-xs font-semibold uppercase tracking-[0.18em] text-accent/80"
        data-i18n-key="avatar.evolution.eyebrow"
      >
        {t('avatar.evolution.eyebrow')}
      </p>
      <h2 class="text-2xl font-heading text-offWhite sm:text-3xl" data-i18n-key="avatar.evolution.heading">
        {t('avatar.evolution.heading')}
      </h2>
    </header>

    <div class="evolution-representation" role="group" aria-label={t('avatar.threeD.representation')} data-i18n-key="avatar.threeD.representation" data-i18n-attr="aria-label">
      <button type="button" data-evolution-mode="2d" aria-pressed="true" data-i18n-key="avatar.threeD.original">{t('avatar.threeD.original')}</button>
      <button type="button" data-evolution-mode="3d" aria-pressed="false" data-i18n-key="avatar.threeD.dimensional">{t('avatar.threeD.dimensional')}</button>
    </div>

    <div class="evolution-frame relative overflow-hidden rounded-2xl border border-white/10 bg-[radial-gradient(circle_at_50%_42%,rgba(32,159,142,0.22),rgba(5,15,29,0.96)_67%)] sm:rounded-[28px]">
      <div
        class="relative mx-auto flex h-[272px] w-full max-w-3xl items-center justify-center sm:h-[360px] lg:h-[410px]"
        data-evolution-canvas
        role="img"
        aria-label={`${firstStage.version}: ${firstTitle}. ${firstDescription}`}
      >
        <span class="evolution-walk-shadow" data-evolution-walk-shadow aria-hidden="true" hidden></span>
        <div class="absolute inset-0 z-[1] flex items-center justify-center" data-evolution-stage></div>
        <div class="evolution-model-host" data-evolution-model-host aria-hidden="true"></div>
        <div
          class="pointer-events-none absolute inset-0 z-[3] overflow-hidden"
          data-evolution-effects
          aria-hidden="true"
          hidden
        >
          <span class="evolution-halo" data-evolution-halo></span>
          <span class="evolution-scan" data-evolution-scan></span>
          <span class="evolution-particle" data-evolution-particle style="--particle-x: 34%; --particle-y: 34%;"></span>
          <span class="evolution-particle" data-evolution-particle style="--particle-x: 48%; --particle-y: 57%;"></span>
          <span class="evolution-particle" data-evolution-particle style="--particle-x: 61%; --particle-y: 39%;"></span>
        </div>
        <img
          class="absolute inset-0 hidden h-full w-full object-contain p-2 sm:p-4"
          data-evolution-static-fallback
          src={firstStage.vectorImage}
          alt=""
          width="1024"
          height="1024"
          decoding="async"
        />
        <div
          class="absolute inset-5 z-[2] hidden items-center justify-center rounded-2xl border border-white/10 bg-[#071321]/90 px-6 text-center text-offWhite/70"
          data-evolution-unavailable
          aria-hidden="true"
          hidden
        >
          <div class="space-y-3">
            <span class="block text-4xl text-accent/60" aria-hidden="true">◇</span>
            <p class="text-sm font-semibold uppercase tracking-[0.12em]" data-evolution-unavailable-label>
              {t('avatar.evolution.stageUnavailable').replace('{version}', firstStage.version)}
            </p>
          </div>
        </div>
        <div class="absolute inset-0 flex items-center justify-center bg-[#071321]/70" data-evolution-loading>
          <div class="flex items-center gap-3 rounded-full border border-white/10 bg-[#071321]/90 px-5 py-3 text-sm text-offWhite/80">
            <span class="h-2.5 w-2.5 rounded-full bg-accent shadow-[0_0_18px_rgba(111,225,195,0.85)] motion-safe:animate-pulse" aria-hidden="true"></span>
            <span data-evolution-loading-label data-i18n-key="avatar.evolution.ready">{t('avatar.evolution.ready')}</span>
          </div>
        </div>
        <div class="evolution-2d-only pointer-events-none absolute inset-x-5 bottom-4 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent" aria-hidden="true"></div>
        <p class="evolution-3d-help" data-i18n-key="avatar.threeD.help">{t('avatar.threeD.help')}</p>
      </div>

      <div class="evolution-3d-tools" data-evolution-3d-tools hidden>
        <p class="evolution-3d-count" aria-label={progress} data-evolution-3d-progress>1 / {avatarEvolutionStages.length}</p>
        <div class="evolution-3d-feedback">
          <span role="status" aria-live="polite" aria-atomic="true" data-evolution-3d-status></span>
          <button type="button" data-evolution-3d-action="retry" data-i18n-key="avatar.threeD.retry" hidden>{t('avatar.threeD.retry')}</button>
        </div>
        <div class="evolution-3d-caption">
          <p data-evolution-3d-meta>{firstStage.version} • {firstStage.date}</p>
          <h3 class="font-heading" data-evolution-3d-title>{firstTitle}</h3>
          <p data-evolution-3d-description>{firstDescription}</p>
        </div>
        <div class="evolution-tour-track" aria-hidden="true"></div>
        <ol class="evolution-filmstrip" data-evolution-3d-filmstrip aria-label={t('avatar.threeD.filmstrip')} data-i18n-key="avatar.threeD.filmstrip" data-i18n-attr="aria-label">
          {avatarEvolutionStages.map((stage, index) => (
            <li data-evolution-3d-marker data-active={index === 0 ? 'true' : 'false'}>
              <button type="button" data-evolution-3d-select={index} aria-current={index === 0 ? 'step' : undefined}>
                <img
                  data-evolution-3d-thumbnail
                  data-src={thumbnails[`../../images/avatar/3d-thumbnails/turtleand-${stage.version.slice(1)}.webp`] ?? stage.vectorImage}
                  alt=""
                  width="248"
                  height="208"
                  decoding="async"
                  fetchpriority="low"
                />
                <span data-evolution-3d-thumbnail-title>{locale === 'es' ? stage.titleEs : stage.title}</span>
              </button>
            </li>
          ))}
        </ol>
      </div>

      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-evolution-status>
        {t('avatar.evolution.ready')}
      </p>

      <div class="evolution-2d-only border-t border-white/10 px-4 py-4 sm:px-6">
        <div class="overflow-x-auto pb-1">
          <ol class="grid gap-2" style={timelineStyle} data-evolution-timeline aria-label={t('avatar.evolution.timelineLabel')} data-i18n-key="avatar.evolution.timelineLabel" data-i18n-attr="aria-label">
            {avatarEvolutionStages.map((stage, index) => (
              <li class="min-w-0" data-evolution-marker data-active={index === 0 ? 'true' : 'false'}>
                <button type="button" class="evolution-timeline-button" data-evolution-select={index} aria-current={index === 0 ? 'step' : undefined} aria-label={`${stage.version}: ${locale === 'es' ? stage.titleEs : stage.title}`}>
                  <span class="mb-2 block h-1.5 rounded-full bg-white/15 transition-colors" data-evolution-marker-bar></span>
                  <span class="block truncate text-center text-[0.58rem] font-semibold tracking-[0.02em] text-offWhite/45 sm:text-xs sm:tracking-[0.06em]">{stage.version}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <p
      class="evolution-2d-only mx-auto max-w-2xl rounded-xl border border-amber-200/20 bg-amber-100/5 px-4 py-3 text-center text-sm text-amber-50/85"
      data-evolution-notice
      role="status"
      hidden
    ></p>

    <p class="sr-only" aria-live="polite" aria-atomic="true" data-evolution-announcement></p>

    <div class="evolution-2d-only min-h-[7.5rem] space-y-1.5 text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-emerald-100/80 sm:text-sm">
        <span data-evolution-meta>{firstStage.version} • {firstStage.date}</span>
        <span aria-hidden="true"> · </span>
        <span data-evolution-progress>{progress}</span>
      </p>
      <h3 class="text-2xl font-heading text-offWhite" data-evolution-title>{firstTitle}</h3>
      <p class="mx-auto max-w-2xl text-sm leading-relaxed text-offWhite/70 sm:text-base" data-evolution-description>{firstDescription}</p>
    </div>

    <div class="evolution-2d-only grid grid-cols-2 gap-2 sm:flex sm:flex-wrap sm:items-center sm:justify-center sm:gap-3" role="group" aria-label={t('avatar.evolution.controlsLabel')} data-i18n-key="avatar.evolution.controlsLabel" data-i18n-attr="aria-label">
      <button type="button" class="evolution-control" data-evolution-action="previous" aria-label={t('avatar.evolution.previous')} data-i18n-key="avatar.evolution.previous" data-i18n-attr="aria-label">
        <span aria-hidden="true">←</span><span data-i18n-key="avatar.evolution.previous">{t('avatar.evolution.previous')}</span>
      </button>
      <button type="button" class="evolution-control evolution-control-primary" data-evolution-action="play" aria-label={t('avatar.evolution.play')}>
        <span aria-hidden="true" data-evolution-play-icon>▶</span><span data-evolution-play-label>{t('avatar.evolution.play')}</span>
      </button>
      <button type="button" class="evolution-control" data-evolution-action="next" aria-label={t('avatar.evolution.next')} data-i18n-key="avatar.evolution.next" data-i18n-attr="aria-label">
        <span data-i18n-key="avatar.evolution.next">{t('avatar.evolution.next')}</span><span aria-hidden="true">→</span>
      </button>
      <button type="button" class="evolution-control" data-evolution-action="restart" aria-label={t('avatar.evolution.restart')} data-i18n-key="avatar.evolution.restart" data-i18n-attr="aria-label">
        <span aria-hidden="true">↺</span><span data-i18n-key="avatar.evolution.restart">{t('avatar.evolution.restart')}</span>
      </button>
    </div>
  </div>
</section>

<script>
  import { avatarEvolutionStages } from '../../data/avatarEvolution';
  import { avatar3dById, avatar3dEnvironmentUrl } from '../../data/avatar3d';
  import { initAvatarEvolution } from './evolution-controller.js';

  const initializeAvatarEvolution = () => initAvatarEvolution(avatarEvolutionStages, avatar3dById, avatar3dEnvironmentUrl);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeAvatarEvolution, { once: true });
  } else {
    initializeAvatarEvolution();
  }
</script>

<style>
  .evolution-representation {
    display: flex;
    width: max-content;
    max-width: 100%;
    margin-inline: auto;
    padding: 3px;
    gap: 3px;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 999px;
    background: #081321;
  }

  .evolution-representation button {
    min-height: 44px;
    min-width: 44px;
    padding: .4rem .85rem;
    border-radius: 999px;
    color: #c6cfd1;
    font-size: .8125rem;
    font-weight: 600;
  }

  .evolution-representation button[aria-pressed='true'] {
    color: #e1f5ec;
    background: #253c36;
  }

  .evolution-representation button:focus-visible,
  .evolution-timeline-button:focus-visible,
  .evolution-3d-feedback button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .evolution-timeline-button { min-height: 44px; width: 100%; padding: .35rem 0; border-radius: 5px; }
  .evolution-model-host { position: absolute; inset: 0; z-index: 2; visibility: hidden; pointer-events: none; }
  .evolution-model-host :global(model-viewer) { width: 100%; height: 100%; --poster-color: transparent; --progress-bar-height: 0px; }
  [data-model-ready='true'] .evolution-model-host { visibility: visible; pointer-events: auto; }
  [data-model-ready='true'] [data-evolution-stage], [data-model-ready='true'] [data-evolution-static-fallback], [data-model-ready='true'] [data-evolution-unavailable] { visibility: hidden; }

  .evolution-gallery[data-representation='3d'] {
    padding: clamp(.5rem, 2vw, 1.25rem);
  }

  [data-representation='3d'] .evolution-content {
    display: grid;
    gap: .75rem;
  }

  [data-representation='3d'] .evolution-content > * {
    margin-block: 0;
  }

  [data-representation='3d'] .evolution-2d-only {
    display: none;
  }

  [data-representation='3d'] .evolution-frame {
    border-color: #2d4049;
    background: #101a25;
  }

  [data-representation='3d'] [data-evolution-canvas] {
    max-width: none;
    height: clamp(215px, 28vh, 270px);
    isolation: isolate;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 49%, #29453f 0%, #172c32 42%, #101c28 76%);
  }

  [data-representation='3d'] [data-evolution-canvas]::before {
    content: '';
    pointer-events: none;
    position: absolute;
    inset: auto 2% -42%;
    margin-inline: auto;
    max-width: 810px;
    height: 105%;
    border-radius: 50%;
    background: repeating-radial-gradient(ellipse, transparent 0 49px, #7ca99b33 50px 51px, transparent 52px 59px);
    mask-image: radial-gradient(ellipse, transparent 0 19%, black 42%, transparent 72%);
    transform: rotateX(62deg);
  }

  .evolution-3d-tools,
  .evolution-3d-help {
    display: none;
  }

  [data-representation='3d'] .evolution-3d-tools:not([hidden]),
  [data-representation='3d'][data-model-ready='true'] .evolution-3d-help {
    display: block;
  }

  .evolution-3d-count,
  .evolution-3d-help {
    position: absolute;
    z-index: 4;
    border: 1px solid #40565d;
    border-radius: 999px;
    padding: .25rem .625rem;
    background: #0b1722ed;
    color: #d6e4e2;
    font-size: .6875rem;
    font-weight: 600;
    line-height: 1.2;
    pointer-events: none;
  }

  .evolution-3d-count {
    inset-block-start: .75rem;
    inset-inline-end: .75rem;
    font-variant-numeric: tabular-nums;
  }

  .evolution-3d-help {
    inset-block-end: .75rem;
    inset-inline-start: .75rem;
  }

  .evolution-3d-feedback {
    position: absolute;
    z-index: 4;
    inset-block-start: .75rem;
    inset-inline-start: .75rem;
    max-width: min(25rem, calc(100% - 4.5rem));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .375rem;
    pointer-events: none;
  }

  .evolution-3d-feedback span:not(:empty),
  .evolution-3d-feedback button {
    border: 1px solid #40565d;
    border-radius: 8px;
    padding: .375rem .625rem;
    background: #0b1722ed;
    color: #d6e4e2;
    font-size: .75rem;
    line-height: 1.35;
  }

  .evolution-3d-feedback span:empty {
    position: absolute;
  }

  .evolution-3d-feedback button {
    min-height: 44px;
    color: var(--color-accent);
    pointer-events: auto;
  }

  .evolution-3d-feedback button[hidden] {
    display: none;
  }

  .evolution-3d-caption {
    display: grid;
    gap: .25rem;
    padding: .625rem .75rem .75rem;
    border-block-start: 1px solid #2d4049;
  }

  .evolution-3d-caption h3 {
    color: var(--color-off-white);
    font-size: clamp(1.375rem, 3vw, 2rem);
    line-height: 1.15;
    text-wrap: balance;
  }

  [data-evolution-3d-meta] {
    color: #a5b8bc;
    font-size: .6875rem;
    font-weight: 600;
    letter-spacing: .035em;
  }

  [data-evolution-3d-description] {
    color: #bdcbcd;
    font-size: .875rem;
    line-height: 1.4;
  }

  .evolution-tour-track {
    height: 3px;
    background: #293d45;
  }

  .evolution-tour-track::before {
    content: '';
    display: block;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(var(--evolution-tour-progress, 0));
    transform-origin: left;
  }

  .evolution-filmstrip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(102px, 35%, 120px);
    gap: .5rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: .625rem .75rem .75rem;
    scroll-padding-inline: .75rem;
    scroll-snap-type: x proximity;
    scrollbar-color: #4e736e transparent;
    scrollbar-width: thin;
  }

  .evolution-filmstrip li {
    min-width: 0;
    scroll-snap-align: start;
  }

  .evolution-filmstrip button {
    width: 100%;
    height: 100%;
    display: grid;
    align-content: start;
    gap: .25rem;
    padding: .25rem .4375rem .4375rem;
    border: 1px solid #32454e;
    border-radius: .5625rem;
    background: #121f2a;
    color: #becdd0;
    text-align: start;
    font-size: .75rem;
    font-weight: 600;
    line-height: 1.18;
    overflow-wrap: anywhere;
  }

  .evolution-filmstrip button:hover {
    background: #1b302f;
  }

  .evolution-filmstrip button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .evolution-filmstrip [data-active='true'] button {
    background: #253c36;
    border-color: #77ad99;
    color: #f1f6f4;
  }

  .evolution-filmstrip [data-pending='true']:not([data-active='true']) button {
    border-color: #77ad99;
    border-style: dashed;
  }

  .evolution-filmstrip img {
    width: 100%;
    height: 52px;
    object-fit: contain;
  }

  .evolution-filmstrip img:not([src]) {
    visibility: hidden;
  }

  @media (min-width: 640px) {
    [data-representation='3d'] [data-evolution-canvas] {
      height: clamp(280px, 36vh, 360px);
    }

    .evolution-3d-caption {
      align-content: center;
      min-height: 6rem;
      padding-inline: 1rem;
    }
  }

  @media (min-width: 768px) {
    .evolution-filmstrip {
      grid-auto-columns: minmax(0, 1fr);
      padding-inline: 1rem;
    }

    .evolution-filmstrip img {
      height: 58px;
    }
  }

  .evolution-control {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    border-radius: 9999px;
    padding: 0.7rem 1rem;
    background: rgb(255 255 255 / 0.05);
    color: rgb(244 244 244 / 0.82);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .evolution-control:hover:not(:disabled) {
    border-color: rgb(111 225 195 / 0.65);
    background: rgb(111 225 195 / 0.1);
    color: #f4f4f4;
    transform: translateY(-1px);
  }

  .evolution-control:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .evolution-control:disabled {
    cursor: not-allowed;
    opacity: 0.38;
  }

  .evolution-control-primary {
    border-color: rgb(111 225 195 / 0.55);
    background: rgb(46 131 115 / 0.34);
    color: #f4f4f4;
  }

  [data-evolution-marker][data-active='true'] [data-evolution-marker-bar] {
    background: var(--color-accent);
    box-shadow: 0 0 18px rgb(111 225 195 / 0.7);
  }

  [data-evolution-marker][data-active='true'] span:last-child {
    color: #f4f4f4;
  }

  .evolution-halo {
    position: absolute;
    inset: 8% 12%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(111 225 195 / 0.2), rgb(38 211 199 / 0.08) 42%, transparent 72%);
    filter: blur(12px);
    opacity: 0;
  }

  .evolution-scan {
    position: absolute;
    top: 7%;
    bottom: 7%;
    left: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, rgb(194 255 239 / 0.85) 16%, rgb(111 225 195 / 0.95) 50%, rgb(194 255 239 / 0.85) 84%, transparent);
    box-shadow: 0 0 12px 3px rgb(111 225 195 / 0.42), 0 0 30px 9px rgb(48 238 218 / 0.14);
    opacity: 0;
    will-change: transform, opacity;
  }

  .evolution-particle {
    position: absolute;
    left: var(--particle-x);
    top: var(--particle-y);
    width: 5px;
    height: 5px;
    border: 1px solid rgb(202 255 241 / 0.9);
    border-radius: 9999px;
    background: rgb(111 225 195 / 0.9);
    box-shadow: 0 0 12px rgb(111 225 195 / 0.8);
    opacity: 0;
    will-change: transform, opacity;
  }

  .evolution-walk-shadow {
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: 5%;
    width: min(68%, 30rem);
    height: 7%;
    border-radius: 9999px;
    background: radial-gradient(ellipse, rgb(0 0 0 / 0.8), rgb(3 12 20 / 0.3) 52%, transparent 76%);
    filter: blur(7px);
    opacity: 0;
    transform: translateX(-50%);
    transform-origin: center;
    will-change: opacity, transform;
  }

  @media (min-width: 640px) {
    .evolution-walk-shadow {
      bottom: 4%;
      width: min(58%, 31rem);
      height: 8%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .evolution-control,
    [data-evolution-marker-bar] {
      transition: none;
    }

    [data-evolution-effects] {
      display: none !important;
    }

    .evolution-walk-shadow {
      display: none !important;
    }
  }
</style>
