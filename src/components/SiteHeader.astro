---
import type { Locale } from "../utils/i18n";

type NavigationLink = {
  href: string;
  baseHref: string;
  label: string;
  key: string;
};

type LocaleCopy = {
  label: string;
  aria: string;
  currentAria: string;
  key: string;
  ariaKey: string;
  currentAriaKey: string;
};

interface Props {
  items?: NavigationLink[];
  locale: Locale;
  localeGroupLabel: string;
  localeMetadata: Record<string, LocaleCopy>;
  avatarGalleryLabel: string;
}

const {
  items = [],
  locale,
  localeGroupLabel,
  localeMetadata,
  avatarGalleryLabel,
}: Props = Astro.props;
const placeholderOrigin = "http://placeholder.internal";
const currentUrl = Astro.url ?? new URL(placeholderOrigin);
const currentPath = currentUrl.pathname ?? "/";
const locales = Object.keys(localeMetadata) as (keyof typeof localeMetadata)[];
const baseToggleClasses =
  "inline-flex min-h-11 items-center justify-center rounded-full border px-4 py-1.5 text-sm font-semibold uppercase tracking-[0.14em] transition-all duration-200 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent focus-visible:ring-offset-[#050f1d] sm:min-h-10 sm:px-4";
const activeToggleClasses =
  "border-accent/70 bg-offWhite text-deepBlue shadow-[inset_0_0_0_1px_rgba(255,255,255,0.55),0_10px_28px_rgba(2,8,20,0.32)]";
const inactiveToggleClasses =
  "border-transparent bg-transparent text-offWhite/68 hover:bg-white/10 hover:text-offWhite focus-visible:text-offWhite";
---

<header
  class="site-header relative sticky top-0 z-50 border-b border-white/15 bg-[#050f1d] supports-[backdrop-filter]:bg-[#050f1dd9] supports-[backdrop-filter]:backdrop-blur-xl shadow-[0_25px_65px_rgba(2,5,12,0.85)]"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col gap-3 px-6 py-4 md:flex-row md:items-center md:justify-between md:px-12"
  >
    <div class="flex items-center gap-4">
      <button
        type="button"
        class="flex items-center gap-4 transition-transform hover:scale-105 focus-visible:scale-105 focus-visible:outline-none"
        data-open-avatar-gallery
        aria-haspopup="dialog"
        aria-controls="avatar-gallery-modal"
        aria-expanded="false"
        aria-label={avatarGalleryLabel}
        data-i18n-key="avatar.modal.openLabel"
        data-i18n-attr="aria-label"
      >
        <img
          src="/logo.svg"
          alt=""
          width="940"
          height="548"
          class="h-12 w-auto sm:h-14 md:h-24"
          loading="lazy"
          decoding="async"
        />
        <span
          class="inline-flex whitespace-nowrap rounded-full border border-white/15 px-4 py-1 text-lg font-heading uppercase tracking-[0.08em] text-offWhite shadow-[0_10px_35px_rgba(5,10,20,0.45)] sm:px-5 sm:py-1.5 sm:text-xl md:text-2xl md:tracking-[0.15em]"
        >
          TurtleanD
        </span>
      </button>
    </div>
    <div class="flex flex-wrap items-center gap-4 md:gap-6 md:justify-end">
      <nav
        aria-label="Main navigation"
        class="flex flex-wrap items-center gap-5 text-base font-medium text-muted"
      >
        {
          items.map(({ label, href, baseHref, key }) => {
            let isActive = false;
            try {
              const itemUrl = new URL(
                href,
                href.startsWith("http") ? undefined : placeholderOrigin,
              );
              isActive = itemUrl.pathname === currentPath;
            } catch {
              isActive = currentPath === href;
            }
            return (
              <a
                class={`group relative tracking-wide transition-colors hover:text-offWhite focus-visible:text-offWhite focus-visible:outline-none ${
                  isActive ? "text-offWhite" : ""
                }`}
                href={href}
                data-base-href={baseHref}
                data-locale-link
                aria-current={isActive ? "page" : undefined}
                data-i18n-key={key}
              >
                {label}
                <span
                  class={`pointer-events-none absolute inset-x-0 -bottom-1 block h-0.5 origin-left rounded-full bg-offWhite transition-all duration-200 ease-out ${
                    isActive
                      ? "scale-x-100 opacity-90 md:opacity-100"
                      : "scale-x-100 opacity-45 md:scale-x-0 md:opacity-0 md:group-hover:scale-x-100 md:group-hover:opacity-100 md:group-focus-visible:scale-x-100 md:group-focus-visible:opacity-100"
                  }`}
                />
              </a>
            );
          })
        }
      </nav>
      <div
        class="flex items-center gap-1 rounded-full border border-white/20 bg-white/[0.07] p-1 text-sm font-semibold uppercase tracking-[0.12em] text-offWhite shadow-[inset_0_1px_0_rgba(255,255,255,0.08)]"
        role="group"
        aria-label={localeGroupLabel}
      >
        {
          locales.map((code) => {
            const metadata = localeMetadata[code];
            const isCurrent = locale === code;
            return (
              <button
                type="button"
                class={`${baseToggleClasses} ${
                  isCurrent ? activeToggleClasses : inactiveToggleClasses
                }`}
                data-locale-button
                data-locale={code}
                data-active={isCurrent ? "true" : "false"}
                aria-pressed={isCurrent}
                aria-current={isCurrent ? "true" : undefined}
                data-active-class={activeToggleClasses}
                data-inactive-class={inactiveToggleClasses}
                data-current-aria-key={metadata.currentAriaKey}
                data-inactive-aria-key={metadata.ariaKey}
                aria-label={isCurrent ? metadata.currentAria : metadata.aria}
              >
                <span data-i18n-key={metadata.key}>{metadata.label}</span>
              </button>
            );
          })
        }
      </div>
    </div>
  </div>
</header>
