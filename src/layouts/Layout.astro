---
import '../styles/globals.css';
import SiteHeader from '../components/SiteHeader.astro';
import AvatarGalleryModal from '../components/avatar/AvatarGalleryModal.astro';
import { primaryNavigation } from '../config/navigation';
import aiBackgroundAsset from '../images/ai.png';
import growthBackgroundAsset from '../images/growth.png';
import buildBackgroundAsset from '../images/build.png';
import blockchainBackgroundAsset from '../images/blockchain.png';
import localeClientModule from '../scripts/locale-client.js?url';
import type { Dictionary, Locale } from '../utils/i18n';
import {
  createTranslator,
  DEFAULT_LOCALE,
  LOCALE_COOKIE,
  serializeDictionaries,
} from '../utils/i18n';

interface Props {
  variant?: 'default' | 'landscape';
  titleKey?: string;
  descriptionKey?: string;
  title?: string;
  description?: string;
  locale: Locale;
  dictionary: Dictionary;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  locale,
  dictionary,
  variant = 'default',
  titleKey = 'site.title',
  descriptionKey = 'site.description',
  title,
  description,
  canonicalURL,
  ogImage = '/social-card.png',
  ogType = 'website',
}: Props = Astro.props;
const t = createTranslator(locale);

const resolvedTitle = title ?? t('site.title');
const resolvedDescription = description ?? t('site.description');
const resolvedCanonicalURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const resolvedOgImage = new URL(ogImage, resolvedCanonicalURL).href;
const siteName = 'Turtleand';

const preloadImages = (variant === 'landscape' ? [] : [
  aiBackgroundAsset,
  growthBackgroundAsset,
  buildBackgroundAsset,
  blockchainBackgroundAsset,
]).map((asset) => asset?.src ?? asset);

const buildLocaleAwareHref = (href: string) => {
  const normalizedHref = href.startsWith('http')
    ? href
    : `http://placeholder${href.startsWith('/') ? '' : '/'}${href}`;
  const url = new URL(normalizedHref);
  if (locale !== DEFAULT_LOCALE) {
    url.searchParams.set('lang', locale);
  } else {
    url.searchParams.delete('lang');
  }
  const path = url.pathname === '/' && !url.search ? '/' : `${url.pathname}${url.search}${url.hash}`;
  return path;
};

const navigationItems = primaryNavigation.map((item) => ({
  baseHref: item.href,
  href: buildLocaleAwareHref(item.href),
  label: dictionary.navigation[item.labelKey],
  key: `navigation.${item.labelKey}`,
}));

const localeMetadata = {
  groupLabel: dictionary.navigation.localeGroupLabel,
  locales: Object.fromEntries(
    Object.entries(dictionary.navigation.locales).map(([key, value]) => [
      key,
      {
        label: value.label,
        aria: value.aria,
        currentAria: value.currentAria,
        key: `navigation.locales.${key}.label`,
        ariaKey: `navigation.locales.${key}.aria`,
        currentAriaKey: `navigation.locales.${key}.currentAria`,
      },
    ]),
  ),
};

const localeBootstrapData = JSON.stringify({
  locale,
  defaultLocale: DEFAULT_LOCALE,
  cookieName: LOCALE_COOKIE,
  translations: serializeDictionaries(),
}).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-i18n-key={titleKey}>{resolvedTitle}</title>
    <meta name="title" content={resolvedTitle} data-i18n-key={variant === 'landscape' ? titleKey : undefined} data-i18n-attr={variant === 'landscape' ? 'content' : undefined} />
    <meta
      name="description"
      content={resolvedDescription}
      data-i18n-key={descriptionKey}
      data-i18n-attr="content"
    />
    <link rel="canonical" href={resolvedCanonicalURL} />
    <link rel="alternate" type="application/json" title="Turtleand feed registry" href="/feeds.json" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={resolvedTitle} data-i18n-key={variant === 'landscape' ? titleKey : undefined} data-i18n-attr={variant === 'landscape' ? 'content' : undefined} />
    <meta property="og:description" content={resolvedDescription} data-i18n-key={variant === 'landscape' ? descriptionKey : undefined} data-i18n-attr={variant === 'landscape' ? 'content' : undefined} />
    <meta property="og:url" content={resolvedCanonicalURL} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} data-i18n-key={variant === 'landscape' ? titleKey : undefined} data-i18n-attr={variant === 'landscape' ? 'content' : undefined} />
    <meta name="twitter:description" content={resolvedDescription} data-i18n-key={variant === 'landscape' ? descriptionKey : undefined} data-i18n-attr={variant === 'landscape' ? 'content' : undefined} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="theme-color" content={variant === 'landscape' ? '#091c22' : '#07182f'} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    {
      preloadImages.map((image) => (
        <link rel="preload" as="image" href={image} />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Turtleand",
      "url": "https://turtleand.com",
      "jobTitle": "Software Engineer & AI Strategist",
      "knowsAbout": ["Artificial Intelligence", "Blockchain", "Software Engineering", "Human-Centered Technology"],
      "sameAs": ["https://github.com/turtleand", "https://x.com/turtleand_world", "https://dev.to/turtleand"]
    }
    </script>
    <slot name="head" />
  </head>
  <body class="bg-deepBlue text-offWhite font-body antialiased min-h-screen">
    {variant === 'landscape' ? <slot /> : <div class="relative overflow-hidden">
      <SiteHeader
        items={navigationItems}
        locale={locale}
        localeGroupLabel={localeMetadata.groupLabel}
        localeMetadata={localeMetadata.locales}
        avatarGalleryLabel={t('avatar.modal.openLabel')}
      />
      <main>
        <slot />
      </main>
      <footer class="mt-24">
        <slot name="footer" />
      </footer>
    </div>}
    <AvatarGalleryModal locale={locale} />
    <script
      is:inline
      set:html={`window.__turtleandLocale = ${localeBootstrapData};`}
    ></script>
    <script type="module" src={localeClientModule}></script>
  </body>
</html>
